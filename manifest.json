{
  "manifest_version": 3,
  "name": "ربات اسکیپ کردن ارزشیابی اساتید",
  "version": "2.0.0",
  "description": "تکمیل خودکار ارزشیابی اساتید دانشگاه آزاد اسلامی",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://stdn2.iau.ir/*",
    "*://*.iau.ir/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://stdn2.iau.ir/*", "*://*.iau.ir/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["logo.png", "inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}